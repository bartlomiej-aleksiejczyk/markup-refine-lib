---
import FullNavigationLayout from "../../astro/layouts/FullNavigationLayout.astro";

const snippetExampleUsage = `<pre data-mr-copyable><code>
    npm install my-package
</code></pre>`;

const renderedSnippet = `npm install my-package`;
---

<FullNavigationLayout>
  <main class="mr-container">
    <h2>Copyable Snippet</h2>

    <p>
      Use the <code>data-mr-copyable</code> attribute on any <code>&lt;pre&gt;</code> element that wraps a <code>&lt;code&gt;</code> block to enable automatic copy functionality. A copy button will be injected automatically if not already present.
    </p>

    <h3>Example usage:</h3>
    <pre data-mr-copyable><code>{snippetExampleUsage}</code></pre>

    <h3>Rendered snippet:</h3>
    <pre data-mr-copyable><code>{renderedSnippet}</code></pre>

    <p>
      When the copy button is clicked, the visible text inside the <code>&lt;code&gt;</code> block is copied to the clipboard. If the Clipboard API is unavailable, a fallback method is used. The generated button has an accessible label and reports success/failure through that label. Without JavaScript the code block remains ordinary readable HTML.
    </p>
  </main>
</FullNavigationLayout>
