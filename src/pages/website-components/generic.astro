---
import LibraryStyleLayout from "../../astro/layouts/LibraryStyleLayout.astro";
---

<LibraryStyleLayout>
  <!-- Navigation Bar -->
  <header class="navbar">
    <div class="mr-nav-brand">MySite</div>
    <div class="mr-cluster">
      <a href="#">Home</a>
      <a href="#">About</a>
      <a href="#">Services</a>
      <a href="#">Contact</a>
    </div>
  </header>

  <!-- Main Content -->
  <main class="mr-container">
    <h1>Welcome to My Sample Site</h1>
    <p>This site is styled using a custom CSS framework.</p>

    <!-- Information Cards -->
    <div class="mr-card mr-card--info">
      <span class="mr-card__header">Information Card</span>
      <p>
        This is an informational card. Use it to display important messages.
      </p>
    </div>

    <div class="mr-card mr-card--positive">
      <span class="mr-card__header">Success Card</span>
      <p>Operation completed successfully!</p>
    </div>

    <div class="mr-card mr-card--negative">
      <span class="mr-card__header">Error Card</span>
      <p>Something went wrong. Please try again.</p>
    </div>

    <div class="mr-card mr-card--warning">
      <span class="mr-card__header">Warning Card</span>
      <p>Proceed with caution.</p>
    </div>

    <!-- Action Buttons -->
    <div class="mr-cluster mr-cluster--center">
      <button class="mr-button--positive">Save</button>
      <button class="mr-button--negative">Delete</button>
      <button class="mr-button--warning">Cancel</button>
    </div>

    <!-- Form -->
    <form>
      <fieldset>
        <legend>Contact Us</legend>
        <label for="name">Name:</label>
        <input type="text" id="name" name="name" placeholder="Your Name" />

        <label for="email">Email:</label>
        <input type="email" id="email" name="email" placeholder="Your Email" />

        <label for="message">Message:</label>
        <textarea
          id="message"
          name="message"
          rows="4"
          placeholder="Your Message"></textarea>

        <input type="submit" value="Send Message" />
        <input type="reset" value="Clear" />
      </fieldset>
    </form>

    <!-- Styled Pill Tags -->
    <div class="mr-cluster">
      <span class="mr-pill">Tech</span>
      <span class="mr-pill mr-pill--secondary">Design</span>
      <span class="mr-pill mr-pill--positive">Success</span>
      <span class="mr-pill mr-pill--negative">Error</span>
      <span class="mr-pill mr-pill--warning">Warning</span>
      <span class="mr-pill mr-pill--info">Info</span>
      <span class="mr-pill mr-pill--help">Help</span>
    </div>
  </main>

  <!-- Footer -->
  <footer>
    <p>&copy; 2025 MySite. All rights reserved.</p>
  </footer>
</LibraryStyleLayout>
