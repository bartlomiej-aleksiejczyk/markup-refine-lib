---
import { base } from "astro:config/client";
import FullNavigationLayout from "../../astro/layouts/FullNavigationLayout.astro";

const staticSearchSnippet = `<button
  class="mr-search-trigger"
  data-mr-search
  data-mr-search-static-url="${base}demo-internal/offline-search-index.json"
>
  Search
</button>`;

const dynamicSearchSnippet = `<button
  class="mr-search-trigger"
  data-mr-search
  data-mr-search-dynamic-url="/api/search?q="
>
  Search
</button>`;
---

<FullNavigationLayout>
  <main class="mr-container mr-shell__main">
    <h1>Search tool</h1>
    <p>
      The search trigger's presentation class and behavior hook are independent:
      <code>mr-search-trigger</code> styles it and <code>data-mr-search</code>
      enables the enhancement.
    </p>
    <p>
      Use exactly one of <code>data-mr-search-static-url</code> or
      <code>data-mr-search-dynamic-url</code>. Generated modal parts use
      <code>mr-search*</code> presentation classes and
      <code>data-mr-search-part</code> behavior/part hooks. The generated modal is
      a native <code>&lt;dialog&gt;</code>: Escape closes it, background content is
      modal/inert while it is open, and focus returns to the trigger on close.
    </p>
    <p>
      Search is an enhancement-only feature. If a no-JavaScript search path is
      required, provide a normal search form or link as the fallback.
    </p>
    <h2>Static search</h2>
    <pre data-mr-copyable><code>{staticSearchSnippet}</code></pre>
    <Fragment set:html={staticSearchSnippet} />
    <h2>Dynamic search</h2>
    <pre data-mr-copyable><code>{dynamicSearchSnippet}</code></pre>
    <button
  class="mr-search-trigger"
  data-mr-search
  data-mr-search-dynamic-url="/api/search?q="
>
  Search
</button>
  </main>
</FullNavigationLayout>
