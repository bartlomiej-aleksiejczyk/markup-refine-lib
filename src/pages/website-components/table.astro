---
import FullNavigationLayout from "../../astro/layouts/FullNavigationLayout.astro";
---

<FullNavigationLayout>
  <main class="mr-container mr-shell__main">
    <h1>Tables</h1>
    <p>Semantic tables are refined inside a <code>data-mr</code> scope.</p>

    <figure>
      <table>
        <thead>
          <tr>
            <th>ID</th>
            <th>Item</th>
            <th>Status</th>
            <th>Price</th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <td data-label="ID">1</td>
            <td data-label="Item">Laptop</td>
            <td data-label="Status"><span class="mr-pill mr-pill--positive">Available</span></td>
            <td data-label="Price">$999</td>
          </tr>
          <tr>
            <td data-label="ID">2</td>
            <td data-label="Item">Headphones</td>
            <td data-label="Status"><span class="mr-pill mr-pill--warning">Low stock</span></td>
            <td data-label="Price">$79</td>
          </tr>
          <tr>
            <td data-label="ID">3</td>
            <td data-label="Item">Smartphone</td>
            <td data-label="Status"><span class="mr-pill mr-pill--negative">Out of stock</span></td>
            <td data-label="Price">$699</td>
          </tr>
        </tbody>
      </table>
    </figure>

    <h2>Wide tables</h2>
    <p>Wrap wide tables in a semantic <code>figure</code> so horizontal overflow remains contained.</p>
    <pre data-mr-copyable><code>{`<figure>
  <table>
    ...
  </table>
</figure>`}</code></pre>
  </main>
</FullNavigationLayout>
