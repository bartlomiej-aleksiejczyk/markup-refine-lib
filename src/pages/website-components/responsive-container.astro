---
import FullNavigationLayout from "../../astro/layouts/FullNavigationLayout.astro";
---

<FullNavigationLayout>
  <main class="mr-container mr-shell__main">
    <h1>Responsive container — deprecated</h1>
    <p>
      The historical <code>responsive-container</code> class is not part of the stable package
      entries. Use the stable layout primitive <code>mr-container</code> instead.
    </p>
    <pre data-mr-copyable><code>{`<main class="mr-container">...</main>`}</code></pre>
    <p>See <a href="../../usage/layout/">Layout primitives</a> for sizing tokens and live examples.</p>
  </main>
</FullNavigationLayout>
