---
import "../../library/markup-refine-lib.css";
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>Markup Refine stable isolation fixture</title>
  </head>
  <body>
    <main id="host-html">
      <section>
        <h1>Host application HTML</h1>
        <p>This section intentionally has no data-mr attribute.</p>
        <form>
          <label for="host-name">Name</label>
          <input id="host-name" name="host-name" />
          <button type="button">Host button</button>
        </form>
      </section>

      <section
        data-mr
        id="mr-html"
        style="--mr-color-primary: hsl(215 70% 42%);"
      >
        <h1>Markup Refine island A</h1>
        <p>Semantic styling and a local token override apply in this scope.</p>
        <button type="button">Refined button</button>

        <section data-mr-unstyled id="unstyled-subtree">
          <h2>Unstyled subtree</h2>
          <button type="button">Host/native-styled button</button>

          <section data-mr id="nested-mr-scope">
            <h3>Nested Markup Refine scope</h3>
            <button type="button">Refined again</button>
          </section>
        </section>

        <button data-mr-unstyled type="button" id="unstyled-control">
          Unstyled single control
        </button>
      </section>

      <section
        data-mr
        id="mr-html-second-theme"
        style="--mr-color-primary: hsl(145 55% 35%);"
      >
        <h2>Markup Refine island B</h2>
        <p>A second scope carries a different inherited token value.</p>
        <a href="/current" aria-current="page">Current link</a>
      </section>
    </main>
  </body>
</html>
