---
import LibraryStyleLayout from "../../astro/layouts/LibraryStyleLayout.astro";
---

<LibraryStyleLayout>
  <header class="navbar">
    <div class="mr-nav-brand">MySite</div>
    <div class="mr-cluster">
      <a href="index.html">Home</a>
      <a href="about.html">About Us</a>
      <a href="contact.html">Contact</a>
      <a href="gallery.html">Gallery</a>
    </div>
  </header>

  <main class="mr-container">
    <h1>Gallery</h1>
    <p>Take a look at some of our favorite projects and memories!</p>

    <div class="mr-cluster mr-cluster--center">
      <figure>
        <img src="images/photo1.jpg" alt="Project 1" />
        <figcaption>Project 1 - Innovative Design</figcaption>
      </figure>
      <figure>
        <img src="images/photo2.jpg" alt="Project 2" />
        <figcaption>Project 2 - Modern Interface</figcaption>
      </figure>
      <figure>
        <img src="images/photo3.jpg" alt="Project 3" />
        <figcaption>Project 3 - Creative Solution</figcaption>
      </figure>
    </div>
  </main>

  <footer>
    <p>&copy; 2025 MySite. All rights reserved.</p>
  </footer>
</LibraryStyleLayout>
