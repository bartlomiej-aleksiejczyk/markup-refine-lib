---
import FullNavigationLayout from "../astro/layouts/FullNavigationLayout.astro";
import { packageMeta } from "../astro/packageMeta";
---

<FullNavigationLayout>
  <main class="mr-container mr-shell__main">
    <h1>Markup Refine</h1>
    <p>
      <strong>{packageMeta.name}</strong> refines semantic HTML without taking over
      the rest of your application. Import the CSS, add <code>data-mr</code> only
      where semantic styling should apply, and opt into components or JavaScript
      behavior only when needed.
    </p>

    <h2>Quick start</h2>
    <pre data-mr-copyable><code>{`import "${packageMeta.name}/css";
import "${packageMeta.name}/behaviors"; // optional`}</code></pre>

    <pre data-mr-copyable><code>{`<main data-mr class="mr-container">
  <h1>Users</h1>
  <form>
    <label>Name <input name="name" /></label>
    <button>Save</button>
  </form>
</main>`}</code></pre>

    <h2>Stable design</h2>
    <ul>
      <li><code>[data-mr]</code> scopes semantic/reset styling.</li>
      <li><code>--mr-*</code> tokens provide theming.</li>
      <li><code>mr-*</code> classes provide explicit component/layout presentation.</li>
      <li><code>data-mr-*</code> provides optional progressive enhancement.</li>
      <li>Native HTML/ARIA carries state whenever possible.</li>
    </ul>

    <p>
      Start with <a href="usage/scoped-mode/">scoped semantic HTML</a>, then see
      <a href="usage/theming/">theming</a>,
      <a href="usage/component-api/">components</a>,
      <a href="usage/layout/">layout</a>, and
      <a href="usage/progressive-enhancement/">progressive enhancement</a>.
    </p>
  </main>
</FullNavigationLayout>
