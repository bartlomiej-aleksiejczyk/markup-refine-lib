{
  "name": "markup-refine-lib",
  "description": "A customizable, lightweight CSS and JS library designed to give a simple way to style HTML with an emphasis on a native HTML look",
  "version": "0.13.0",
  "type": "module",
  "license": "Apache-2.0",
  "files": [
    "dist",
    "NOTICE",
    "AI-USAGE.md"
  ],
  "homepage": "https://bartlomiej-aleksiejczyk.github.io/markup-refine-lib/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bartlomiej-aleksiejczyk/markup-refine-lib.git"
  },
  "scripts": {
    "build": "npm run build:library:unminified && npm run build:library:minified",
    "build:library:unminified": "vite build --mode library-unminified",
    "build:library:minified": "vite build --mode library-minified",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.app.json && tsc -p tsconfig.node.json",
    "astro:dev": "node src/build/buildDev.js & astro dev --host",
    "astro:build": "astro build && node src/build/buildDocs.js",
    "astro:preview": "astro preview",
    "release": "node src/build/releaseNewVersion.js"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^5.1.1",
    "@tsconfig/svelte": "^5.0.5",
    "@types/node": "^22.18.0",
    "astro": "^7.3.3",
    "jsdom": "^26.1.0",
    "mustache": "^4.2.0",
    "sass": "^1.91.0",
    "svelte": "^5.38.5",
    "svelte-check": "^4.3.1",
    "typescript": "~5.7.2",
    "vite": "^6.3.5"
  },
  "dependencies": {
    "fuse.js": "^7.1.0",
    "markup-refine-lib": "^0.10.0"
  },
  "style": "./dist/markup-refine-lib.css",
  "exports": {
    "./css": "./dist/markup-refine-lib.css",
    "./tokens": "./dist/markup-refine-lib-tokens.css",
    "./base": "./dist/markup-refine-lib-base.css",
    "./components": "./dist/markup-refine-lib-components.css",
    "./layout": "./dist/markup-refine-lib-layout.css",
    "./behaviors": "./dist/markup-refine-lib-behaviors.js",
    "./layers": "./dist/markup-refine-lib-layers.js",
    "./tooltips": "./dist/markup-refine-lib-tooltips.js",
    "./layer-navigation": "./dist/markup-refine-lib-layer-navigation.js",
    "./package.json": "./package.json"
  },
  "sideEffects": [
    "./dist/*.css",
    "./dist/markup-refine-lib-behaviors.js",
    "./dist/markup-refine-lib-behaviors.min.js"
  ]
}